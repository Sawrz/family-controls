  "narrative": {
    "northStar": "Today’s family plan",
    "overview": "The family planner uses forest navigation, a warm cream ground and quiet sage work areas to make account changes easy to read. Compact labels, separated rows and plain controls support both quick phone checks and longer desktop administration.\n\nThe visual system keeps the child, computer and operating-system account together. Color reinforces written status; allowance previews distinguish the total budget from what remains. English and German use the same layout, with wrapping instead of truncated labels.",
    "keyCharacteristics": [
      "Forest navigation and warm, flat working surfaces.",
      "Separated account rows with tabular time figures.",
      "Scope-aware change headings and before/after allowance previews.",
      "Equal phone and desktop access with visible keyboard focus."
    ],
    "rules": [
      {
        "name": "The Written State Rule",
        "body": "Pair state color with a readable status; a pending change must not appear applied.",
        "section": "colors"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "Use tonal surfaces and thin dividers to group work; the shipped system has no shadows.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep child, computer and account labels together.",
      "Do show total allowance and remaining time as separate before/after values.",
      "Do let English and German labels wrap and keep phone controls available.",
      "Do use written unknown, pending and failure states alongside their color."
    ],
    "donts": [
      "Don’t imply that an accepted or queued command is already applied.",
      "Don’t present unknown usage as zero or draw a usage bar without reliable values.",
      "Don’t label persistent or multi-day changes as today-only."
    ]
  }
