    "@types/node": "^24.0.0",
    "axe-core": "^4.14.0",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "prettier": "^3.6.0",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte": "5.57.2",
    "svelte-check": "^4.3.0",
    "typescript": "6.0.3",
    "v8-to-istanbul": "^9.3.0",
    "vite": "8.3.5"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
